<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Release version (Major.Minor); also tagged on GitHub as v<Version>. -->
    <Version>1.0</Version>
    <Product>GameCatalog</Product>
    <Company>Adam Skowroński</Company>
    <Authors>Adam Skowroński</Authors>
    <Copyright>© 2026 Adam Skowroński. GNU GPL v3. Port of Ant Movie Catalog — https://www.antp.be/software/moviecatalog/</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/askowron/GameCatalog</RepositoryUrl>
  </PropertyGroup>
</Project>
